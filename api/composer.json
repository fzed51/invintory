{
    "name": "fzed51/invintory",
    "description": "API de l'application Invintory (cave à vin)",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.7",
        "php-di/slim-bridge": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CaveAVin\\": "CaveAVin/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaveAVin\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:http": "phpunit --testsuite http",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text --coverage-html ../coverage/php"
        ]
    },
    "authors": [
        {
            "name": "Fabien Sanchez",
            "email": "fabien.sanchez@citopia.fr"
        }
    ],
    "scripts-descriptions": {
        "test:integration": "Suite d'intégration : nécessite « docker compose up -d db »",
        "test:coverage": "Couverture (Xdebug ou pcov), rapport HTML dans coverage/php"
    }
}
