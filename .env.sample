# Secret key used for JWT token signing.
# HS256 requires at least 256 bits (32 bytes) — a shorter value is rejected.
# Change this value before deploying to production.
JWT_SECRET=invintory-dev-secret-change-me-in-production

# Joint le détail des exceptions (type, message, fichier, ligne, trace) aux
# réponses d'erreur de l'API et réactive l'affichage des erreurs PHP.
# À laisser désactivé hors développement : ces informations décrivent
# l'arborescence du serveur.
APP_DEBUG=false
