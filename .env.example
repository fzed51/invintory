# Copier en .env (racine du projet, hors webroot). Ne jamais versionner .env.

# true : expose le détail des erreurs dans l'enveloppe JSON (développement uniquement)
APP_DEBUG=false
# Journal des erreurs 500, hors webroot (défaut : logs/api.log à la racine du projet)
# APP_LOG_FILE=

# MySQL. Sous Docker, DB_HOST vaut « db » (service du docker-compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=invintory
DB_USER=invintory
DB_PASSWORD=changeme
# Mot de passe root du conteneur MySQL (doublure Docker uniquement)
DB_ROOT_PASSWORD=root

# Jeton exigé par POST /api/internal/migrate (en-tête X-Deploy-Token), appelé par la CI.
# Vide = route toujours refusée. Générer une valeur longue et aléatoire, par exemple :
#   php -r "echo bin2hex(random_bytes(32));"
DEPLOY_TOKEN=

# auth-service (docs/ressources/auth-service-integration.md). En local : la doublure Docker
# (service « auth »), qui lit ces mêmes valeurs. En production : l'URL réelle et les
# identifiants transmis par l'exploitant du service, jamais versionnés.
AUTH_SERVICE_URL=http://auth:8081
AUTH_CLIENT_ID=invintory-dev
# Doublure : n'importe quelle valeur non vide, partagée avec le service « auth ».
AUTH_CLIENT_SECRET=
# Cache du JWKS, hors webroot (défaut : cache/ à la racine du projet)
# APP_CACHE_DIR=
# Photos des bouteilles, hors webroot (défaut : photos/ à la racine du projet)
# APP_PHOTOS_DIR=
